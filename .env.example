# OpenRouter API Key
NEXT_PUBLIC_OPENROUTER_API_KEY=your_api_key_here

# Optional: App URL for OpenRouter
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Trio Chat

# URL Parameters (Alternative to localStorage):
# - API Key: ?api=YOUR_API_KEY
# - Custom Endpoint: ?endpoint=https://your-api-endpoint.com/v1/chat/completions
# - Custom Models: ?models=anthropic/claude-sonnet-4.5,openai/gpt-5,google/gemini-2.5-pro
#
# Example full URL:
# http://localhost:3000?api=YOUR_KEY&models=anthropic/claude-sonnet-4.5,openai/gpt-4-turbo
#
# Note: URL parameters take priority over localStorage settings
